# --- Auth ---
# Fail-closed: every /api/v1/* request is rejected until this is set. JSON list of allowed keys.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=["change-me"]

# --- LLM provider ---
# "openai" or "anthropic"
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
# OpenAI embeddings are required regardless of LLM_PROVIDER (used for the interaction-corpus index).
EMBEDDING_MODEL=text-embedding-3-small

# --- Graph behavior ---
MAX_SYNTHESIS_RETRIES=2

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
