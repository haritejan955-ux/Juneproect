# Copy this file to `backend/.env` for local (non-Docker) backend development,
# or to `.env` at the repo root for `docker compose up` (see docker-compose.yml,
# which loads it via `env_file`). Every key the backend reads is listed here.

# ── LLM Provider ──────────────────────────────────────────────────
# "openai" or "anthropic" — selects which chat model backs every agent node.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
LLM_TEMPERATURE=0.0

# Embeddings are always OpenAI regardless of LLM_PROVIDER — Anthropic has no
# embeddings endpoint. See docs/design-decisions.md, decision #2.
# OPENAI_API_KEY above is required even when LLM_PROVIDER=anthropic.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Application ───────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# ── Storage ───────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/claims.db
VECTOR_INDEX_DIR=./data/indices
POLICY_CORPUS_DIR=./data/policy_corpus
SYNTHETIC_CLAIMS_DIR=./data/synthetic_claims
UPLOAD_STORAGE_DIR=./data/uploads

# ── RAG ───────────────────────────────────────────────────────────
RAG_SIMILARITY_THRESHOLD=0.65
RAG_TOP_K=5

# ── Self-Critic retry loop ─────────────────────────────────────────
SELF_CRITIC_SCORE_THRESHOLD=0.80
SELF_CRITIC_MAX_RETRIES=2

# ── Security ────────────────────────────────────────────────────────
SECURITY_BLOCK_CONFIDENCE=0.70
UPLOAD_MAX_BYTES=15000000
ALLOWED_UPLOAD_CONTENT_TYPES=["application/pdf"]

# ── Frontend (copy to frontend/.env.local) ────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
