# Used by `docker compose up` (docker-compose.yml's backend service reads this via env_file,
# and the frontend build args below configure the frontend image).
# Copy to `.env` and fill in real values before running `make docker-up`.

# --- Auth ---
API_KEYS=["change-me"]

# --- LLM provider ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
EMBEDDING_MODEL=text-embedding-3-small

# --- Graph behavior ---
MAX_SYNTHESIS_RETRIES=2

# --- Storage (container-internal path; persisted via the backend_data volume) ---
DATABASE_URL=sqlite+aiosqlite:////app/data/app.db

# --- App ---
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend build args ---
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=change-me
