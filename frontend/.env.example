NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Must match one of the keys in the backend's API_KEYS setting. This is a static
# shared-secret key embedded in a client bundle, appropriate for this project's scope (a
# single trusted first-party frontend) — see docs/security-architecture.md "API
# authentication" for the explicit scope note on what this scheme does and doesn't cover.
NEXT_PUBLIC_API_KEY=
